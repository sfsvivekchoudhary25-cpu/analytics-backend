PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://ighub:ighub@localhost:5433/ighub
# Login for the admin panel
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
# 32 bytes as 64 hex chars (encrypts the Instagram token at rest):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Webhooks (Meta dashboard -> Instagram -> Configure webhooks)
# Verify token: any random string; paste the same value into the dashboard.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Instagram App Secret from "API setup with Instagram login" (signs incoming events)
INSTAGRAM_APP_SECRET=
# Public https address of THIS backend (tunnel or domain). Meta downloads photos from it.
PUBLIC_BASE_URL=https://<your-public-domain>
# Secret your website sends as the x-api-key header when submitting photos.
SUBMISSIONS_API_KEY=
# Comma-separated origins of your website (for browser CORS), optional.
PUBLIC_SITE_ORIGINS=
# Optional caption line; {username} is replaced. Default: Thank you @{username} for sharing this with us!
POST_CAPTION_TEMPLATE=
INSTAGRAM_APP_ID=
# Must match the Redirect URL saved in Meta "Business login settings" exactly.
INSTAGRAM_REDIRECT_URI=https://<your-public-domain>/instagram/oauth/callback

# AI-written replies (optional), via OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# Rehearse automatic replies without sending or posting anything (1 = on)
AUTO_REPLY_DRY_RUN=
# Instagram usernames that must never get an automatic reply, comma separated (meta.ai is always ignored)
AUTO_REPLY_IGNORE_USERNAMES=

# Instagram Graph API version used for all calls (default v26.0)
INSTAGRAM_API_VERSION=v26.0
